{
  "id": "pocket_factory",
  "name": "Pocket Factory",
  "version": "3.2.0",
  "author": "YoungLion",
  "category": "Management",
  "description": "Deepened factory management with six production lines, inventories, managers, research, contracts, storage upgrades, offline income and Crown prestige progression.",
  "package_format": "rcc-v1",
  "entry": "Main.qml",
  "icon": "POC",
  "icon_path": "assets/icon.png",
  "min_app_version": "0.6.2",
  "license": "GPL-3.0-or-later",
  "license_file": "LICENSE",
  "source_available": true,
  "default_locale": "en",
  "locales": [
    "en",
    "tr",
    "az",
    "de",
    "es",
    "fr",
    "ru",
    "pt"
  ],
  "tags": [
    "factory",
    "management",
    "idle",
    "production",
    "contracts",
    "research",
    "desktop",
    "mobile"
  ],
  "capabilities": [
    "theme",
    "save",
    "settings",
    "haptics",
    "i18n",
    "stats",
    "achievements",
    "random",
    "events",
    "lifecycle"
  ],
  "save_version": 2,
  "plugin_level": 2,
  "orientation": "any",
  "settings_schema": {
    "showHints": {
      "type": "bool",
      "default": true,
      "label": "Show production hints"
    },
    "reducedMotion": {
      "type": "bool",
      "default": false,
      "label": "Reduced motion"
    }
  }
}
