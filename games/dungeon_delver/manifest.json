{
  "id": "dungeon_delver",
  "name": "Dungeon Delver",
  "version": "6.6.3",
  "author": "YoungLion",
  "publisher": "YoungLion",
  "category": "Roguelike",
  "description": "Expanded turn-based roguelike with three playable classes and active skills, three dungeon art styles, multicolor SVG characters/enemies/items, canonical full-run saves, Soul Shard meta progression, shops, relics, bosses, responsive desktop/mobile controls, rich SFX, theme/i18n integration and procedural connected floors.",
  "package_format": "rcc-v1",
  "entry": "Main.qml",
  "icon": "DUN",
  "icon_path": "assets/icon.png",
  "min_app_version": "0.6.2",
  "license": "GPL-3.0-or-later",
  "license_file": "LICENSE",
  "source_available": true,
  "default_locale": "en",
  "locales": [
    "en",
    "tr",
    "az",
    "ru",
    "de",
    "fr",
    "es",
    "pt",
    "zh",
    "ja"
  ],
  "plugin_level": 2,
  "save_version": 2,
  "orientation": "any",
  "capabilities": [
    "theme",
    "save",
    "settings",
    "i18n",
    "input",
    "lifecycle",
    "audio",
    "stats",
    "achievements",
    "haptics",
    "random"
  ],
  "tags": [
    "active-skills",
    "bosses",
    "classes",
    "desktop",
    "dungeon",
    "first-floor-content",
    "inventory",
    "meta-progression",
    "mobile",
    "official",
    "procedural",
    "roguelike",
    "svg",
    "younglion"
  ],
  "settings_schema": {
    "sound": {
      "type": "bool",
      "default": true,
      "label": "Sound"
    },
    "vibration": {
      "type": "bool",
      "default": true,
      "label": "Vibration"
    },
    "visualStyle": {
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 2,
      "label": "Visual style"
    }
  }
}
