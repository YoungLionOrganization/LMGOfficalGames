{
  "id": "gem_cascade",
  "name": "Gem Cascade",
  "version": "6.7.0",
  "author": "YoungLion",
  "publisher": "YoungLion",
  "category": "Puzzle",
  "description": "Polished responsive match-3 campaign with direct special activation/combinations, Nova gems, Android-ready SFX routing, distinct special/booster icons, subtle impact shake/flash, optional vibration, objectives, stars, safe saves and desktop/mobile controls. Progression now awards non-farmable boosters on new clears, first 3-star achievements and 5-level milestones.",
  "package_format": "rcc-v1",
  "entry": "Main.qml",
  "icon": "GEM",
  "icon_path": "assets/icon.png",
  "min_app_version": "0.6.2",
  "license": "GPL-3.0-or-later",
  "license_file": "LICENSE",
  "source_available": true,
  "default_locale": "en",
  "locales": [
    "en",
    "tr",
    "az",
    "ru",
    "de",
    "fr",
    "es",
    "pt",
    "zh",
    "ja"
  ],
  "tags": [
    "cascade",
    "match3",
    "desktop",
    "mobile",
    "official",
    "puzzle",
    "special-gems",
    "younglion"
  ],
  "capabilities": [
    "achievements",
    "events",
    "haptics",
    "i18n",
    "input",
    "lifecycle",
    "random",
    "save",
    "settings",
    "stats",
    "theme",
    "audio"
  ],
  "save_version": 2,
  "plugin_level": 2,
  "orientation": "any",
  "settings_schema": {
    "sound": {
      "type": "bool",
      "default": true,
      "label": "Sound"
    },
    "haptics": {
      "type": "bool",
      "default": true,
      "label": "Vibration"
    },
    "showHints": {
      "type": "bool",
      "default": true,
      "label": "Show hints"
    },
    "reducedMotion": {
      "type": "bool",
      "default": false,
      "label": "Reduced motion"
    }
  }
}
