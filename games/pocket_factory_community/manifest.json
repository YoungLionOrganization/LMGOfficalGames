{
  "id": "pocket_factory_community",
  "name": "Pocket Factory Community",
  "version": "4.0.0",
  "author": "YoungLion",
  "category": "Management",
  "description": "Grow a six-line factory into a city with permanent patents, production routes, industrial orders, and Crown progression.",
  "package_format": "rcc-v1",
  "entry": "Main.qml",
  "icon": "POC",
  "icon_path": "assets/icon.png",
  "min_app_version": "0.7.3",
  "license": "GPL-3.0-or-later",
  "license_file": "LICENSE",
  "source_available": true,
  "default_locale": "en",
  "locales": [
    "en",
    "tr",
    "az",
    "de",
    "es",
    "fr",
    "ru",
    "pt"
  ],
  "tags": [
    "factory",
    "management",
    "idle",
    "production",
    "contracts",
    "research",
    "desktop",
    "mobile"
  ],
  "capabilities": [
    "theme",
    "save",
    "settings",
    "haptics",
    "i18n",
    "stats",
    "achievements",
    "random",
    "events",
    "lifecycle"
  ],
  "save_version": 3,
  "plugin_level": 2,
  "orientation": "any",
  "settings_schema": {
    "showHints": {
      "type": "bool",
      "default": true,
      "label": "Show production hints"
    },
    "reducedMotion": {
      "type": "bool",
      "default": false,
      "label": "Reduced motion"
    },
    "factoryScene": {
      "type": "int",
      "label": "Factory scene (0 Off, 1 Low, 2 Full)"
    },
    "factoryShowFlow": {
      "type": "bool",
      "default": true,
      "label": "Show production flow"
    }
  },
  "source_url": "https://github.com/YoungLionOrganization/LMGOfficalGames/tree/main/games/pocket_factory_community"
}
